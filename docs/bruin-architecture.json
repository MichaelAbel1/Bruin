  "cards": [
    {
      "dot": "cyan",
      "title": "从一次文件读取开始",
      "items": [
        "用户提交问题后，执行循环组织上下文，请模型选择下一步。",
        "模型申请读取文件时，Bruin 检查权限，经工具执行器把请求发给子进程。"
      ]
    },
    {
      "dot": "emerald",
      "title": "结果怎样回到对话",
      "items": [
        "子进程把输出按请求 ID 交回。执行循环写入会话事件，再连同工具结果询问模型。",
        "SQLite 还保存会话租约，让桌面、CLI 和定时服务协调同一会话的执行权。"
      ]
    },
    {
      "dot": "violet",
      "title": "复杂任务由谁协调",
      "items": [
        "运行时管理计划、任务依赖、后台命令、子 Agent 和 MCP 连接。",
        "后台命令和 Hook 也使用工具执行器。子 Agent 在自己的会话中运行。"
      ]
    }
  ]
